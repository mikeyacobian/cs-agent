# cs-agent environment variables
# Copy this file to `.env` (gitignored) and fill in the values you need.
# You only need keys for the providers you actually use.

# ---------- Agent under test ----------
# The model that powers the customer service agent.
# Options: claude | openai | mock
AGENT_PROVIDER=claude
AGENT_MODEL=claude-sonnet-4-6

# ---------- LLM judge ----------
# The model that grades the agent's open-ended responses.
# Default uses a different provider from AGENT_PROVIDER to reduce
# self-preference bias (cross-model judging).
# Options: claude | openai | mock
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o

# ---------- API keys ----------
# Set whichever providers you use above. Unused keys can be left blank.
# Provider code never reads these directly; the SDKs read them from env
# automatically. The harness validates the required key is set at startup.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
