# cs-agent environment variables
# Copy to `.env` (gitignored) and fill in the keys you have.
# You only need keys for the providers you actually use.

# ---------- Agent under test ----------
# The model that powers the customer service triage agent.
# Options: openai | mock | claude (stub in this build)
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-4o-mini

# ---------- LLM judge ----------
# The model that grades the agent's open-ended responses.
# Default uses a stronger tier of the same vendor (cross-tier judging,
# partial self-preference bias mitigation). For true cross-vendor judging,
# set JUDGE_PROVIDER=claude and provide ANTHROPIC_API_KEY.
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o

# ---------- API keys ----------
# Provider code never reads these directly; the SDKs handle that.
# Unused keys can be left blank.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=  # only needed for cross-vendor judging (architecturally supported, not demo'd)
